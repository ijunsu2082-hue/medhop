# Which backend the site talks to. It is fixed when the site is built and never changes while a page is open.
#   python   (the default when unset): the MedHop backend on this computer, simulator or real drone.
#            npm run dev, npm run build.
#   browser: the simulator runs inside the page; no backend is needed. npm run dev:browser, npm run build:browser
#            (Vite mode "browser", which reads the committed .env.browser).
# Any other value stops the build. On Netlify only a browser build is allowed.
VITE_BACKEND=python

# Base URL of the MedHop backend (python builds only). WebSocket URLs are derived from it (http -> ws, https -> wss).
VITE_API_BASE=http://localhost:8010
