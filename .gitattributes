# Text files are stored and checked out with LF line endings on every platform, so the shell scripts run
# under Git Bash on Windows and diffs stay quiet. Windows-only scripts keep CRLF.
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.pdf binary
*.pt binary
